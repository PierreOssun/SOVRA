# systemd unit for the Pi cosigner (party 1). Install as
# /etc/systemd/system/sovra-cosigner.service — see DEPLOY_RUNBOOK.md.
#
# WorkingDirectory is load-bearing: every path in cosigner1.toml (data_dir,
# policy_path, tls_*, seal_key_path) is resolved relative to the cwd.
[Unit]
Description=SOVRA cosigner shard (party 1)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=sovra
Group=sovra
WorkingDirectory=/opt/sovra
ExecStart=/opt/sovra/sovra-cosigner config/cosigner1.toml
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sovra/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
