# Copy beside mac.yml as .env (sovra init does this) and fill in.
# Tailscale IPs are stable per node — they are what the certs' SANs pin.
MAC_TS_IP=
CLOUD_TS_IP=
PI_TS_IP=
SOVRA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Leave empty until the roster ceremony; then paste the line `sovra roster`
# prints (comma-separated hex verifying keys, index = party id):
SOVRA_PARTICIPANTS=
SOVRA_CERTS_DIR=./certs
SOVRA_CONFIG_DIR=./config
SOVRA_TAG=latest
