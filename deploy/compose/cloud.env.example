# Copy to .env beside cloud.yml and fill in. Tailscale IPs are stable per
# node — they are what the certs' SANs pin.
CLOUD_TS_IP=100.64.0.1
PI_TS_IP=100.64.0.2
MAC_TS_IP=100.64.0.3
SOVRA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Leave empty until the roster ceremony; then paste the line `sovra roster`
# prints (comma-separated hex verifying keys, index = party id):
SOVRA_PARTICIPANTS=
# Where the project CA cert + this host's leaves live (see `sovra-cli certs`):
SOVRA_CERTS_DIR=./certs
# Policy files (policy0.toml here):
SOVRA_CONFIG_DIR=./config
SOVRA_TAG=latest
